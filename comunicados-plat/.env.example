# Environment variables declared in this file are automatically made available to Prisma and NestJS.
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Database configuration (PostgreSQL example)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comunicados_db?schema=public"

# JWT configuration
JWT_SECRET="super-secret-key-change-in-production-min-32-chars-long"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7

