datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Sucursal {
  idSucursal    String         @id @default(uuid()) @map("id_sucursal") @db.Uuid
  nombre        String         @unique @db.VarChar(100)
  direccion     String         @db.VarChar(255)
  departamentos Departamento[]

  @@map("sucursal")
}

model Departamento {
  idDepartamento String    @id @default(uuid()) @map("id_departamento") @db.Uuid
  nombre         String    @unique @db.VarChar(100)
  idSucursal     String?   @map("id_sucursal") @db.Uuid
  usuarios       Usuario[]
  sucursal       Sucursal? @relation(fields: [idSucursal], references: [idSucursal], onDelete: Restrict)

  @@index([idSucursal])
  @@map("departamento")
}

model Roles {
  idRol       String        @id @default(uuid()) @map("id_rol") @db.Uuid
  nombre      String        @unique @db.VarChar(50)
  usuarios    Usuario[]
  rolPermisos RolPermiso[]

  @@map("roles")
}

model Permiso {
  idPermiso   String        @id @default(uuid()) @map("id_permiso") @db.Uuid
  nombre      String        @unique @db.VarChar(100)
  rolPermisos RolPermiso[]

  @@map("permiso")
}

model RolPermiso {
  idRol     String  @map("id_rol") @db.Uuid
  idPermiso String  @map("id_permiso") @db.Uuid
  rol       Roles   @relation(fields: [idRol], references: [idRol], onDelete: Cascade)
  permiso   Permiso @relation(fields: [idPermiso], references: [idPermiso], onDelete: Cascade)

  @@id([idRol, idPermiso])
  @@index([idPermiso])
  @@map("rol_permiso")
}

model Usuario {
  idUsuario      String       @id @default(uuid()) @map("id_usuario") @db.Uuid
  nombre         String       @db.VarChar(150)
  correo         String       @unique @db.VarChar(150)
  password       String       @db.VarChar(255)
  telefono       String?      @db.VarChar(25)
  idRol          String       @map("id_rol") @db.Uuid
  idDepartamento String       @map("id_departamento") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  rol            Roles        @relation(fields: [idRol], references: [idRol])
  departamento   Departamento @relation(fields: [idDepartamento], references: [idDepartamento])
  sesiones       Sesion[]
  comunicadosEmitidos  Comunicado[]             @relation("UsuarioGeneraComunicados")
  comunicadosRecibidos ComunicadoDestinatario[] @relation("UsuarioRecibeComunicados")
  dispositivosPush     PushDevice[]

  @@index([idRol])
  @@index([idDepartamento])
  @@map("usuario")
}

model Sesion {
  idSesion         String   @id @default(uuid()) @map("id_sesion") @db.Uuid
  idUsuario        String   @map("id_usuario") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash") @db.VarChar(255)
  fechaInicio      DateTime @default(now()) @map("fecha_inicio")
  fechaExpiracion  DateTime @map("fecha_expiracion")
  isRevoked        Boolean  @default(false) @map("is_revoked")
  userAgent        String?  @map("user_agent") @db.Text
  ipAddress        String?  @map("ip_address") @db.VarChar(45)

  usuario          Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@index([idUsuario])
  @@index([refreshTokenHash])
  @@map("sesion")
}

model Comunicado {
  idComunicado     String    @id @default(uuid()) @map("id_comunicado") @db.Uuid
  codigo           String    @unique @db.VarChar(30)
  titulo           String    @db.VarChar(150)
  extracto         String?   @db.VarChar(280)
  medioPublicacion String    @default("AVANZADO") @map("medio_publicacion") @db.VarChar(50)
  prioridad        String    @default("NORMAL") @db.VarChar(30)
  estado           String    @default("PUBLICADO") @db.VarChar(30)
  tipoAlcance      String    @default("TODA_EMPRESA") @map("tipo_alcance") @db.VarChar(50)
  fechaPublicacion DateTime? @default(now()) @map("fecha_publicacion")
  fechaProgramada  DateTime? @map("fecha_programada")
  idUsuario        String    @map("id_usuario") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  autor            Usuario                  @relation("UsuarioGeneraComunicados", fields: [idUsuario], references: [idUsuario])
  cuerpo           Cuerpo?
  imagenes         Imagenes[]
  notificaciones   Notificacion[]
  destinatarios    ComunicadoDestinatario[]

  @@index([idUsuario])
  @@index([estado, prioridad])
  @@map("comunicado")
}

model Cuerpo {
  idCuerpo      String     @id @default(uuid()) @map("id_cuerpo") @db.Uuid
  contenido     String     @db.Text
  urlArchivo    String?    @map("url_archivo") @db.VarChar(500)
  nombreArchivo String?    @map("nombre_archivo") @db.VarChar(255)
  tamanoBytes   Int?       @map("tamano_bytes")
  numeroPaginas Int?       @map("numero_paginas")
  idComunicado  String     @unique @map("id_comunicado") @db.Uuid

  comunicado    Comunicado @relation(fields: [idComunicado], references: [idComunicado], onDelete: Cascade)

  @@map("cuerpo")
}

model Imagenes {
  idImagen      String     @id @default(uuid()) @map("id_imagen") @db.Uuid
  urlImagen     String     @map("url_imagen") @db.VarChar(500)
  nombreArchivo String?    @map("nombre_archivo") @db.VarChar(255)
  tamanoBytes   Int?       @map("tamano_bytes")
  esPortada     Boolean    @default(false) @map("es_portada")
  orden         Int        @default(0)
  idComunicado  String     @map("id_comunicado") @db.Uuid

  comunicado    Comunicado @relation(fields: [idComunicado], references: [idComunicado], onDelete: Cascade)

  @@index([idComunicado])
  @@map("imagenes")
}

model ComunicadoDestinatario {
  idComunicadoDestinatario String     @id @default(uuid()) @map("id_comunicado_destinatario") @db.Uuid
  estadoLectura            String     @default("PENDIENTE") @map("estado_lectura") @db.VarChar(30)
  fechaVisualizacion       DateTime?  @map("fecha_visualizacion")
  fechaConfirmacion        DateTime?  @map("fecha_confirmacion")
  idComunicado             String     @map("id_comunicado") @db.Uuid
  idUsuario                String     @map("id_usuario") @db.Uuid

  comunicado               Comunicado @relation(fields: [idComunicado], references: [idComunicado], onDelete: Cascade)
  usuario                  Usuario    @relation("UsuarioRecibeComunicados", fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@unique([idComunicado, idUsuario])
  @@index([idUsuario, estadoLectura])
  @@map("comunicado_destinatario")
}

model Notificacion {
  idNotificacion String     @id @default(uuid()) @map("id_notificacion") @db.Uuid
  tipo           String     @default("PUSH_MOVIL") @db.VarChar(50)
  estado         String     @default("ENVIADA") @db.VarChar(30)
  fechaEnvio     DateTime   @default(now()) @map("fecha_envio")
  idComunicado   String     @map("id_comunicado") @db.Uuid

  comunicado     Comunicado @relation(fields: [idComunicado], references: [idComunicado], onDelete: Cascade)

  @@index([idComunicado])
  @@map("notificacion")
}

model PushDevice {
  id        String   @id @default(uuid()) @db.Uuid
  idUsuario String   @map("id_usuario") @db.Uuid
  token     String   @unique @db.Text
  platform  String   @default("web") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuario   Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@index([idUsuario])
  @@map("push_devices")
}

